{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:execution-safety": "node --import tsx --test tests/executionSafety.test.ts",
    "test:security": "node --import tsx --test tests/*.test.ts",
    "testnet:reconcile": "node --import tsx scripts/reconcile_testnet_orders.ts",
    "testnet:account": "node --import tsx scripts/reconcile_testnet_account.ts",
    "testnet:protection": "node --import tsx scripts/audit_testnet_protection.ts",
    "testnet:positions": "node --import tsx scripts/audit_testnet_positions.ts",
    "testnet:replacement-plan": "node --import tsx scripts/plan_testnet_stop_replacement.ts",
    "testnet:commission": "node --import tsx scripts/audit_testnet_commission.ts",
    "testnet:valuation": "node --import tsx scripts/value_testnet_account.ts",
    "testnet:equity-record": "node --import tsx scripts/record_testnet_equity.ts",
    "testnet:activity": "node --import tsx scripts/record_testnet_activity.ts",
    "testnet:backfill": "node --import tsx scripts/backfill_testnet_trades.ts",
    "testnet:recover-history": "node --import tsx scripts/recover_testnet_history.ts",
    "testnet:watch": "node --import tsx scripts/watch_testnet_account.ts",
    "testnet:preflight": "node --import tsx scripts/preflight_testnet.ts",
    "testnet:valuation-diagnostics": "node --import tsx scripts/diagnose_testnet_valuation.ts",
    "testnet:order-check": "node --import tsx scripts/check_testnet_order.ts",
    "testnet:sandbox-init": "node --import tsx scripts/scoped_testnet_capital.ts init",
    "testnet:sandbox-status": "node --import tsx scripts/scoped_testnet_capital.ts status",
    "testnet:sandbox-halt": "node --import tsx scripts/scoped_testnet_capital.ts halt",
    "testnet:sandbox-buy-once": "node --import tsx scripts/buy_testnet_once.ts",
    "testnet:sandbox-sell-once": "node --import tsx scripts/sell_testnet_once.ts",
    "testnet:signals": "node --import tsx scripts/observe_testnet_signals.ts",
    "testnet:decision": "node --import tsx scripts/observe_scoped_decision.ts",
    "testnet:decision-watch": "node --import tsx scripts/watch_scoped_decisions.ts",
    "testnet:decision-history": "node --import tsx scripts/read_decision_history.ts",
    "testnet:decision-analysis": "node --import tsx scripts/analyze_decision_history.ts",
    "testnet:strategy-backtest": "node --import tsx scripts/backtest_ema_cross.ts",
