{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:execution-safety": "node --import tsx --test tests/executionSafety.test.ts",
    "test:security": "node --import tsx --test tests/*.test.ts",
    "testnet:reconcile": "node --import tsx scripts/reconcile_testnet_orders.ts",
    "testnet:account": "node --import tsx scripts/reconcile_testnet_account.ts",
    "testnet:protection": "node --import tsx scripts/audit_testnet_protection.ts",
    "testnet:positions": "node --import tsx scripts/audit_testnet_positions.ts",
    "testnet:replacement-plan": "node --import tsx scripts/plan_testnet_stop_replacement.ts",
    "testnet:commission": "node --import tsx scripts/audit_testnet_commission.ts",
    "testnet:valuation": "node --import tsx scripts/value_testnet_account.ts",
    "testnet:equity-record": "node --import tsx scripts/record_testnet_equity.ts",
    "testnet:activity": "node --import tsx scripts/record_testnet_activity.ts",
    "testnet:backfill": "node --import tsx scripts/backfill_testnet_trades.ts",
    "testnet:recover-history": "node --import tsx scripts/recover_testnet_history.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
